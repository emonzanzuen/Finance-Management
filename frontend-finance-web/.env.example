# Alamat API. Untuk development biarkan /api/v1 (diteruskan oleh proxy Vite ke VITE_PROXY_TARGET).
# Untuk build production, isi dengan alamat backend lengkap, misalnya https://api.contoh.com/api/v1
VITE_API_URL=/api/v1

# Alamat backend lokal yang dituju proxy Vite saat development.
VITE_PROXY_TARGET=http://localhost:3000
